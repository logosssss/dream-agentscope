<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.zhu.readmodel.persistence.event.AgentEventAuditMapper">

    <!-- 查询时的列映射。插入走 BaseMapper.insert，不在这里重复写 INSERT。 -->
    <resultMap id="BaseResultMap" type="com.zhu.readmodel.entity.event.AgentEventAudit">
        <id column="id" property="id"/>
        <result column="event_id" property="eventId"/>
        <result column="event_type" property="eventType"/>
        <result column="user_id" property="userId"/>
        <result column="session_id" property="sessionId"/>
        <result column="run_id" property="runId"/>
        <result column="source" property="source"/>
        <result column="payload" property="payload"/>
        <result column="created_at" property="createdAt"/>
    </resultMap>

    <!-- 管理端最近审计。LIMIT 用占位符，避免把条数拼进 SQL。 -->
    <select id="recent" resultMap="BaseResultMap">
        SELECT id, event_id, event_type, user_id, session_id, run_id, source, payload, created_at
        FROM agent_event_audit
        ORDER BY id DESC
        LIMIT #{limit}
    </select>

    <!--
      按运行号 / 会话 / 操作者过滤。三个条件互相 AND，空串表示该条件不参与。
      运维最常见的用法是拿报障里的请求号先查 agent_run，再用 run_id 看这一轮的中间步骤。
    -->
    <select id="search" resultMap="BaseResultMap">
        SELECT id, event_id, event_type, user_id, session_id, run_id, source, payload, created_at
        FROM agent_event_audit
        <where>
            <if test="userId != null and userId != ''">
                AND user_id = #{userId}
            </if>
            <if test="sessionId != null and sessionId != ''">
                AND session_id = #{sessionId}
            </if>
            <if test="runId != null and runId != ''">
                AND run_id = #{runId}
            </if>
        </where>
        ORDER BY id DESC
        LIMIT #{limit}
    </select>

</mapper>
