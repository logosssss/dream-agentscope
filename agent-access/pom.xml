<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.zhu</groupId>
        <artifactId>dream-agentscope</artifactId>
        <version>0.1.0-SNAPSHOT</version>
    </parent>

    <artifactId>agent-access</artifactId>
    <name>agent-access</name>

    <dependencies>
        <dependency>
            <groupId>com.zhu</groupId>
            <artifactId>agent-common</artifactId>
        </dependency>
        <dependency>
            <groupId>com.zhu</groupId>
            <artifactId>agent-ops</artifactId>
    </dependency>

    <dependency>
      <groupId>com.zhu</groupId>
      <artifactId>agent-readmodel</artifactId>
        </dependency>
        <dependency>
            <groupId>com.zhu</groupId>
            <artifactId>agent-semantic</artifactId>
        </dependency>
        <dependency>
            <groupId>com.zhu</groupId>
            <artifactId>agent-runtime</artifactId>
        </dependency>
        <dependency>
            <groupId>com.zhu</groupId>
            <artifactId>agent-state</artifactId>
        </dependency>
        <dependency>
            <groupId>com.zhu</groupId>
            <artifactId>agent-vector</artifactId>
        </dependency>
        <dependency>
            <groupId>com.zhu</groupId>
            <artifactId>agent-object-store</artifactId>
        </dependency>
        <dependency>
            <groupId>com.zhu</groupId>
            <artifactId>agent-cache-api</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <!-- 就绪探测仍用 RedisConnectionFactory 类型；建连在 agent-cache-redis。 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-redis</artifactId>
        </dependency>
        <dependency>
            <groupId>com.baomidou</groupId>
            <artifactId>mybatis-plus-spring-boot3-starter</artifactId>
        </dependency>
        <!-- 聊天附件 attachment_read：PDF / docx 抽文本 -->
        <dependency>
            <groupId>org.apache.pdfbox</groupId>
            <artifactId>pdfbox</artifactId>
            <version>3.0.3</version>
        </dependency>
        <dependency>
            <groupId>org.apache.poi</groupId>
            <artifactId>poi-ooxml</artifactId>
            <version>5.2.5</version>
        </dependency>
        <!-- 闸门顺序等纯单元测试；不 mock Redis，替身用 lambda。 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- 复用测试替身：StubProductModule 等，只在测试类路径上。 -->
        <dependency>
            <groupId>com.zhu</groupId>
            <artifactId>agent-test-support</artifactId>
            <type>test-jar</type>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!--
              接入层只能通过 runtime 的 api 端口使用 Agent 能力；
              直接声明 AgentScope 构件会让层边界在编译期就可绕过（ArchUnit 只在测试期拦）。
              searchTransitive=false：只约束本模块的直接声明，传递依赖由 ArchUnit 管包级引用。
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-enforcer-plugin</artifactId>
                <executions>
                    <execution>
                        <id>enforce-access-boundaries</id>
                        <phase>validate</phase>
                        <goals>
                            <goal>enforce</goal>
                        </goals>
                        <configuration>
                            <rules>
                                <bannedDependencies>
                                    <searchTransitive>false</searchTransitive>
                                    <excludes>
                                        <exclude>io.agentscope:*</exclude>
                                        <exclude>com.zhu:agent-cache-redis</exclude>
                                    </excludes>
                                    <message>agent-access 不得直接依赖 AgentScope 实现或 Redis 缓存实现：前者会绕开 runtime 端口，后者会绕开 CacheFacade。</message>
                                </bannedDependencies>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
