# 示例片段：挂进 www.dream-saas.com 的 listen 443 server { } 内。
# 现网由 deploy/scripts/remote-enable-web-admin-nginx.sh 生成真实 snippet（含令牌，勿提交）。
#
# 静态：/opt/dream-saas/ops  ← web-admin 构建产物（VITE_ADMIN_BASE=/ops/ VITE_ADMIN_GATEWAY=true）
# API：/api/admin/ → 127.0.0.1:8100，X-Caller-Token = AGENTSCOPE_ADMIN_TOKEN

set $admin_token "REPLACE_WITH_AGENTSCOPE_ADMIN_TOKEN";

location = /ops {
    return 302 /ops/;
}

# ^~ + alias：避开站点全局 ~* \.(js|css)$，否则 assets 404
location ^~ /ops/assets/ {
    alias /opt/dream-saas/ops/assets/;
    access_log off;
    expires 7d;
}

location ^~ /ops/ {
    alias /opt/dream-saas/ops/;
    index index.html;
}

location /api/admin/ {
    proxy_pass http://127.0.0.1:8100;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header X-Caller-Token $admin_token;
    proxy_buffering off;
    proxy_read_timeout 120s;
}
