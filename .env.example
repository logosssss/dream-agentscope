# 本地 / 进程启动环境变量示例。复制为 .env 后填写，勿提交真实值。
# 优先级：环境变量 > Nacos > 本地 yml。配了 NACOS_ADDR 时用户/管理进程会拉 infra + 业务配置。

# Nacos（这四项必须留在环境变量，不要写进 Nacos 正文）
NACOS_ADDR=
NACOS_NAMESPACE=
NACOS_USERNAME=
NACOS_PASSWORD=

# 用户进程与管理进程调用方令牌必须不同（也可只配在对应 infra yaml）
# 勿使用 change-me / change-me-caller / change-me-admin；空白或占位串会导致进程拒绝启动。
AGENTSCOPE_CALLER_TOKEN=
AGENTSCOPE_ADMIN_TOKEN=

# 可选：模型密钥未放进 Nacos infra 时的兜底
# DASHSCOPE_API_KEY=
