<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.5.5</version>
        <relativePath/>
    </parent>

    <groupId>com.zhu</groupId>
    <artifactId>dream-agentscope</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <packaging>pom</packaging>
    <name>dream-agentscope</name>

    <modules>
        <module>agent-common</module>
        <module>agent-db</module>
        <module>agent-vector</module>
        <module>agent-object-store</module>
        <module>agent-cache</module>
        <module>agent-state</module>
        <module>agent-semantic</module>
        <module>agent-runtime</module>
        <module>agent-products</module>
        <module>agent-access</module>
        <module>agent-admin</module>
        <module>agent-bootstrap</module>
    </modules>

    <properties>
        <java.version>21</java.version>
        <agentscope.version>2.0.5</agentscope.version>
        <archunit.version>1.4.1</archunit.version>
        <mybatis-plus.version>3.5.17</mybatis-plus.version>
        <opentelemetry.version>1.61.0</opentelemetry.version>
        <milvus.version>2.6.17</milvus.version>
        <aliyun.oss.version>0.6.1</aliyun.oss.version>
        <aws.sdk.version>2.29.51</aws.sdk.version>
        <!-- 现网 Nacos Server 3.3.0；BOM 强制对齐，避免被 agentscope-extensions-nacos-prompt 拉回旧传递依赖。 -->
        <nacos.client.version>3.3.0</nacos.client.version>
        <!-- 与 Spring Boot 3.5.x / spring-data-redis 3.5 对齐的 Redisson 线。 -->
        <redisson.version>3.50.0</redisson.version>
        <!-- 传递依赖收敛用；随 milvus/grpc 升级时同步复核（见 -Pstrict 的 dependencyConvergence）。 -->
        <protobuf.version>3.25.5</protobuf.version>
        <errorprone.annotations.version>2.38.0</errorprone.annotations.version>
        <httpclient.version>4.5.14</httpclient.version>
        <maven-enforcer-plugin.version>3.5.0</maven-enforcer-plugin.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>com.zhu</groupId>
                <artifactId>agent-common</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.zhu</groupId>
                <artifactId>agent-db</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.zhu</groupId>
                <artifactId>agent-vector</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.zhu</groupId>
                <artifactId>agent-object-store</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.zhu</groupId>
                <artifactId>agent-cache</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.zhu</groupId>
                <artifactId>agent-cache-api</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.zhu</groupId>
                <artifactId>agent-cache-redis</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.zhu</groupId>
                <artifactId>agent-state</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.zhu</groupId>
                <artifactId>agent-semantic</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.zhu</groupId>
                <artifactId>agent-runtime</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.zhu</groupId>
                <artifactId>agent-products</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.zhu</groupId>
                <artifactId>agent-product-companion</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.zhu</groupId>
                <artifactId>agent-access</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.zhu</groupId>
                <artifactId>agent-admin</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.zhu</groupId>
                <artifactId>agent-bootstrap</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>io.agentscope</groupId>
                <artifactId>agentscope-core</artifactId>
                <version>${agentscope.version}</version>
            </dependency>
            <dependency>
                <groupId>io.agentscope</groupId>
                <artifactId>agentscope-harness</artifactId>
                <version>${agentscope.version}</version>
            </dependency>
            <dependency>
                <groupId>io.agentscope</groupId>
                <artifactId>agentscope-extensions-mysql</artifactId>
                <version>${agentscope.version}</version>
            </dependency>
            <dependency>
                <groupId>io.agentscope</groupId>
                <artifactId>agentscope-extensions-model-dashscope</artifactId>
                <version>${agentscope.version}</version>
            </dependency>
            <dependency>
                <groupId>io.agentscope</groupId>
                <artifactId>agentscope-extensions-nacos-prompt</artifactId>
                <version>${agentscope.version}</version>
            </dependency>
            <dependency>
                <groupId>com.alibaba.nacos</groupId>
                <artifactId>nacos-client</artifactId>
                <version>${nacos.client.version}</version>
            </dependency>
            <dependency>
                <groupId>com.tngtech.archunit</groupId>
                <artifactId>archunit-junit5</artifactId>
                <version>${archunit.version}</version>
            </dependency>
            <dependency>
                <groupId>com.baomidou</groupId>
                <artifactId>mybatis-plus-spring-boot3-starter</artifactId>
                <version>${mybatis-plus.version}</version>
            </dependency>
            <dependency>
                <groupId>io.opentelemetry</groupId>
                <artifactId>opentelemetry-sdk-extension-autoconfigure</artifactId>
                <version>${opentelemetry.version}</version>
            </dependency>
            <dependency>
                <groupId>io.opentelemetry</groupId>
                <artifactId>opentelemetry-exporter-otlp</artifactId>
                <version>${opentelemetry.version}</version>
            </dependency>
            <dependency>
                <groupId>io.milvus</groupId>
                <artifactId>milvus-sdk-java</artifactId>
                <version>${milvus.version}</version>
            </dependency>
            <!--
              Milvus SDK 会经 gRPC/gson 拉进多个版本的 protobuf 与 errorprone 注解；
              在 BOM 里钉到全线最高版本，让 -Pstrict 的 dependencyConvergence 可用。
            -->
            <dependency>
                <groupId>com.google.protobuf</groupId>
                <artifactId>protobuf-java</artifactId>
                <version>${protobuf.version}</version>
            </dependency>
            <dependency>
                <groupId>com.google.errorprone</groupId>
                <artifactId>error_prone_annotations</artifactId>
                <version>${errorprone.annotations.version}</version>
            </dependency>
            <!-- AWS SDK 的 apache-client 仍指 4.5.13，与 Spring Boot BOM 的 4.5.14 冲突，取高版本。 -->
            <dependency>
                <groupId>org.apache.httpcomponents</groupId>
                <artifactId>httpclient</artifactId>
                <version>${httpclient.version}</version>
            </dependency>
            <dependency>
                <groupId>com.aliyun</groupId>
                <artifactId>alibabacloud-oss-v2</artifactId>
                <version>${aliyun.oss.version}</version>
            </dependency>
            <dependency>
                <groupId>software.amazon.awssdk</groupId>
                <artifactId>bom</artifactId>
                <version>${aws.sdk.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>org.redisson</groupId>
                <artifactId>redisson</artifactId>
                <version>${redisson.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-surefire-plugin</artifactId>
                    <configuration>
                        <!--
                          AgentScope 的 JsonFileAgentStateStore 默认写到 ~/.agentscope；
                          指到模块 target 下，避免污染开发者家目录，也保证 CI 上每次从干净目录开始。
                        -->
                        <argLine>-Duser.home=${project.build.directory}/test-home</argLine>
                    </configuration>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-enforcer-plugin</artifactId>
                    <version>${maven-enforcer-plugin.version}</version>
                </plugin>
            </plugins>
        </pluginManagement>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <skip>true</skip>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-enforcer-plugin</artifactId>
                <executions>
                    <execution>
                        <id>enforce-build-environment</id>
                        <phase>validate</phase>
                        <goals>
                            <goal>enforce</goal>
                        </goals>
                        <configuration>
                            <rules>
                                <requireJavaVersion>
                                    <version>[21,22)</version>
                                    <message>本项目按 JDK 21 编译与测试；换 JDK 前先确认 AgentScope 2.0.5 的兼容区间。</message>
                                </requireJavaVersion>
                                <requireMavenVersion>
                                    <version>[3.9,)</version>
                                </requireMavenVersion>
                                <banDuplicatePomDependencyVersions/>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <!--
          strict：依赖收敛等在"能跑就行"之外的校验放在这里。
          默认构建不激活，因为 Nacos/AgentScope 的传递依赖未必立刻收敛；
          CI 用 -Pstrict 跑 full verify，本地重构时可关掉。
        -->
        <profile>
            <id>strict</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-enforcer-plugin</artifactId>
                        <executions>
                            <execution>
                                <id>enforce-dependency-convergence</id>
                                <phase>validate</phase>
                                <goals>
                                    <goal>enforce</goal>
                                </goals>
                                <configuration>
                                    <rules>
                                        <dependencyConvergence>
                                            <!--
                                              AgentScope 2.0.5 的传递依赖自身不收敛（okhttp/okio/jsonschema-generator）；
                                              这些是实现内部坐标，盲钉版本会改变运行时行为，先排除，
                                              等能定位到具体 API 再在 BOM 里钉死并逐条删除。
                                            -->
                                            <excludes>
                                                <exclude>com.squareup.okhttp3:*</exclude>
                                                <exclude>com.squareup.okio:*</exclude>
                                                <exclude>com.github.victools:jsonschema-generator</exclude>
                                            </excludes>
                                        </dependencyConvergence>
                                    </rules>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
