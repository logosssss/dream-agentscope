<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.zhu.semantic.infrastructure.persistence.ToolPermissionMapper">

    <!-- 查询时的列映射。这张表当前只读，不在这里写 INSERT。 -->
    <resultMap id="BaseResultMap" type="com.zhu.semantic.infrastructure.persistence.entity.ToolPermission">
        <id column="id" property="id"/>
        <result column="tool_id" property="toolId"/>
        <result column="tenant_id" property="tenantId"/>
        <result column="role_id" property="roleId"/>
        <result column="decision" property="decision"/>
        <result column="conditions" property="conditions"/>
        <result column="priority" property="priority"/>
        <result column="enabled" property="enabled"/>
    </resultMap>

    <!-- 只取仍启用的规则。工具名由调用方传入。 -->
    <select id="selectEnabled" resultMap="BaseResultMap">
        SELECT id, tool_id, tenant_id, role_id, decision, conditions, priority, enabled
        FROM tool_permission
        WHERE tool_id = #{toolId}
          AND enabled = 1
    </select>
</mapper>
