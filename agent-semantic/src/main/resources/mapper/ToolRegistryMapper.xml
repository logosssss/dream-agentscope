<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.zhu.semantic.infrastructure.persistence.ToolRegistryMapper">

    <!-- 运行目录只需要标识、展示名和说明。版本和参数结构先不参与注册。 -->
    <resultMap id="BaseResultMap" type="com.zhu.semantic.infrastructure.persistence.entity.ToolRegistry">
        <id column="id" property="id"/>
        <result column="tool_id" property="toolId"/>
        <result column="name" property="name"/>
        <result column="description" property="description"/>
    </resultMap>

    <!-- 管理列表含版本、模块和启用。不读 param_schema。 -->
    <resultMap id="ListResultMap" type="com.zhu.semantic.infrastructure.persistence.entity.ToolRegistry">
        <id column="id" property="id"/>
        <result column="tool_id" property="toolId"/>
        <result column="name" property="name"/>
        <result column="version" property="version"/>
        <result column="module" property="module"/>
        <result column="description" property="description"/>
        <result column="enabled" property="enabled"/>
    </resultMap>

    <select id="listEnabled" resultMap="BaseResultMap">
        SELECT id, tool_id, name, description
        FROM tool_registry
        WHERE enabled = 1
        ORDER BY tool_id
    </select>

    <select id="recent" resultMap="ListResultMap">
        SELECT id, tool_id, name, version, module, description, enabled
        FROM tool_registry
        ORDER BY created_at DESC, id DESC
        LIMIT #{limit}
    </select>

    <select id="findByToolId" resultMap="ListResultMap">
        SELECT id, tool_id, name, version, module, description, enabled
        FROM tool_registry
        WHERE tool_id = #{toolId}
        LIMIT 1
    </select>

    <update id="disableEnabled">
        UPDATE tool_registry
        SET enabled = 0
        WHERE tool_id = #{toolId}
          AND enabled = 1
    </update>

    <update id="restoreDisabled">
        UPDATE tool_registry
        SET enabled = 1
        WHERE tool_id = #{toolId}
          AND enabled = 0
    </update>
</mapper>
