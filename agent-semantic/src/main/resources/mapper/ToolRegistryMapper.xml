<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.zhu.semantic.infrastructure.persistence.ToolRegistryMapper">

    <!-- 目录只需要标识、展示名和说明。版本和参数结构先不参与注册。 -->
    <resultMap id="BaseResultMap" type="com.zhu.semantic.infrastructure.persistence.entity.ToolRegistry">
        <id column="id" property="id"/>
        <result column="tool_id" property="toolId"/>
        <result column="name" property="name"/>
        <result column="description" property="description"/>
    </resultMap>

    <select id="listEnabled" resultMap="BaseResultMap">
        SELECT id, tool_id, name, description
        FROM tool_registry
        WHERE enabled = 1
        ORDER BY tool_id
    </select>
</mapper>
