<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.zhu.audit.infrastructure.persistence.OperationAuditMapper">

    <resultMap id="ListResultMap" type="com.zhu.audit.infrastructure.persistence.entity.OperationAudit">
        <id column="id" property="id"/>
        <result column="operator_id" property="operatorId"/>
        <result column="tenant_id" property="tenantId"/>
        <result column="operation" property="operation"/>
        <result column="object_type" property="objectType"/>
        <result column="object_id" property="objectId"/>
    </resultMap>

    <!-- 不带前后快照。创建时间只用于排序。 -->
    <select id="recent" resultMap="ListResultMap">
        SELECT id, operator_id, tenant_id, operation, object_type, object_id
        FROM operation_audit
        ORDER BY created_at DESC, id DESC
        LIMIT #{limit}
    </select>
</mapper>
