<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.zhu.audit.infrastructure.persistence.tenant.LoginCredentialMapper">

    <resultMap id="BaseResultMap" type="com.zhu.audit.infrastructure.persistence.entity.tenant.LoginCredential">
        <id column="id" property="id"/>
        <result column="tenant_id" property="tenantId"/>
        <result column="user_id" property="userId"/>
        <result column="login_name" property="loginName"/>
        <result column="password_salt" property="passwordSalt"/>
        <result column="password_hash" property="passwordHash"/>
        <result column="open_id" property="openId"/>
    </resultMap>

    <!-- 密码登录只认这一对。不读微信行。 -->
    <select id="findByTenantAndLoginName" resultMap="BaseResultMap">
        SELECT id, tenant_id, user_id, login_name, password_salt, password_hash, open_id
        FROM login_credential
        WHERE tenant_id = #{tenantId}
          AND login_name = #{loginName}
    </select>

    <!-- 同一个 openid 永远是同一个客户端账号。 -->
    <select id="findByOpenId" resultMap="BaseResultMap">
        SELECT id, tenant_id, user_id, login_name, password_salt, password_hash, open_id
        FROM login_credential
        WHERE open_id = #{openId}
    </select>
</mapper>
