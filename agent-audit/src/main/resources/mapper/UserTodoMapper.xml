<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.zhu.audit.infrastructure.persistence.UserTodoMapper">

    <resultMap id="ListResultMap" type="com.zhu.audit.infrastructure.persistence.entity.UserTodo">
        <id column="id" property="id"/>
        <result column="todo_type" property="todoType"/>
        <result column="ref_id" property="refId"/>
        <result column="title" property="title"/>
        <result column="status" property="status"/>
    </resultMap>

    <!-- 这个用户还开着的待办。含审批、确认和任务。不返回截止时间。 -->
    <select id="openApprovals" resultMap="ListResultMap">
        SELECT id, todo_type, ref_id, title, status
        FROM user_todo
        WHERE user_id = #{userId}
          AND status = 'OPEN'
        ORDER BY created_at DESC, id DESC
        LIMIT #{limit}
    </select>

    <!-- 决定后关掉这张审批待办。已经关过的行不动。 -->
    <update id="closeApproval">
        UPDATE user_todo
        SET status = #{status}
        WHERE todo_type = 'APPROVAL'
          AND ref_id = #{refId}
          AND status = 'OPEN'
    </update>

    <!-- 当前用户关确认或任务。审批待办和已经关上的行不动。 -->
    <update id="closeOpen">
        UPDATE user_todo
        SET status = #{status}
        WHERE id = #{id}
          AND user_id = #{userId}
          AND status = 'OPEN'
          AND todo_type IN ('CONFIRM', 'TASK')
    </update>

    <!-- 详情含已关闭行。不带回截止时间。 -->
    <resultMap id="DetailResultMap" type="com.zhu.audit.infrastructure.persistence.entity.UserTodo">
        <id column="id" property="id"/>
        <result column="todo_type" property="todoType"/>
        <result column="ref_id" property="refId"/>
        <result column="title" property="title"/>
        <result column="status" property="status"/>
        <result column="created_at" property="createdAt"/>
    </resultMap>

    <select id="findOwned" resultMap="DetailResultMap">
        SELECT id, todo_type, ref_id, title, status, created_at
        FROM user_todo
        WHERE id = #{id}
          AND user_id = #{userId}
        LIMIT 1
    </select>
</mapper>
