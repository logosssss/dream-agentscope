<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.zhu.audit.infrastructure.persistence.UserTodoMapper">

    <resultMap id="ListResultMap" type="com.zhu.audit.infrastructure.persistence.entity.UserTodo">
        <id column="id" property="id"/>
        <result column="todo_type" property="todoType"/>
        <result column="ref_id" property="refId"/>
        <result column="title" property="title"/>
        <result column="status" property="status"/>
    </resultMap>

    <!-- 只看这个用户还开着的审批待办。不返回截止时间。 -->
    <select id="openApprovals" resultMap="ListResultMap">
        SELECT id, todo_type, ref_id, title, status
        FROM user_todo
        WHERE user_id = #{userId}
          AND todo_type = 'APPROVAL'
          AND status = 'OPEN'
        ORDER BY created_at DESC, id DESC
        LIMIT #{limit}
    </select>
</mapper>
