<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.zhu.audit.infrastructure.persistence.AgentTaskScheduleMapper">

    <resultMap id="ListResultMap" type="com.zhu.audit.infrastructure.persistence.entity.AgentTaskSchedule">
        <id column="id" property="id"/>
        <result column="schedule_id" property="scheduleId"/>
        <result column="task_type" property="taskType"/>
        <result column="cron_expr" property="cronExpr"/>
        <result column="delay_seconds" property="delaySeconds"/>
    </resultMap>

    <!-- 管理列表看全部启用状态。不读任务参数和触发时间。 -->
    <select id="recent" resultMap="ListResultMap">
        SELECT id, schedule_id, task_type, cron_expr, delay_seconds
        FROM agent_task_schedule
        ORDER BY created_at DESC, id DESC
        LIMIT #{limit}
    </select>
</mapper>
