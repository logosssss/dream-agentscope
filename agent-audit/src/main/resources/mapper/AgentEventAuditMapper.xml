<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.zhu.audit.infrastructure.persistence.event.AgentEventAuditMapper">

    <!-- 查询时的列映射。插入走 BaseMapper.insert，不在这里重复写 INSERT。 -->
    <resultMap id="BaseResultMap" type="com.zhu.audit.infrastructure.persistence.entity.event.AgentEventAudit">
        <id column="id" property="id"/>
        <result column="event_id" property="eventId"/>
        <result column="event_type" property="eventType"/>
        <result column="user_id" property="userId"/>
        <result column="session_id" property="sessionId"/>
        <result column="run_id" property="runId"/>
        <result column="source" property="source"/>
        <result column="payload" property="payload"/>
        <result column="created_at" property="createdAt"/>
    </resultMap>

    <!-- 管理端最近审计。LIMIT 用占位符，避免把条数拼进 SQL。 -->
    <select id="recent" resultMap="BaseResultMap">
        SELECT id, event_id, event_type, user_id, session_id, run_id, source, payload, created_at
        FROM agent_event_audit
        ORDER BY id DESC
        LIMIT #{limit}
    </select>

</mapper>
