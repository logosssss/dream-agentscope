<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.zhu.audit.infrastructure.persistence.AttachmentMapper">

    <resultMap id="OwnerResultMap" type="com.zhu.audit.infrastructure.persistence.entity.Attachment">
        <id column="id" property="id"/>
        <result column="attachment_id" property="attachmentId"/>
        <result column="user_id" property="userId"/>
    </resultMap>

    <!-- 写引用前确认附件还在。只取归属，不带回路径。 -->
    <select id="findByAttachmentId" resultMap="OwnerResultMap">
        SELECT id, attachment_id, user_id
        FROM attachment
        WHERE attachment_id = #{attachmentId}
        LIMIT 1
    </select>

    <resultMap id="StoredResultMap" type="com.zhu.audit.infrastructure.persistence.entity.Attachment">
        <result column="attachment_id" property="attachmentId"/>
        <result column="tenant_id" property="tenantId"/>
        <result column="user_id" property="userId"/>
        <result column="file_name" property="fileName"/>
        <result column="storage_path" property="storagePath"/>
        <result column="mime_type" property="mimeType"/>
        <result column="status" property="status"/>
    </resultMap>

    <!-- 下载前取路径和类型。不带回校验和。 -->
    <select id="findStored" resultMap="StoredResultMap">
        SELECT attachment_id, tenant_id, user_id, file_name, storage_path, mime_type, status
        FROM attachment
        WHERE attachment_id = #{attachmentId}
        LIMIT 1
    </select>

    <resultMap id="ListResultMap" type="com.zhu.audit.infrastructure.persistence.entity.Attachment">
        <result column="attachment_id" property="attachmentId"/>
        <result column="tenant_id" property="tenantId"/>
        <result column="user_id" property="userId"/>
        <result column="session_id" property="sessionId"/>
        <result column="file_name" property="fileName"/>
        <result column="storage_type" property="storageType"/>
        <result column="storage_path" property="storagePath"/>
        <result column="status" property="status"/>
    </resultMap>

    <!-- 本人本租户仍启用的附件。不带回校验和。 -->
    <select id="listOwned" resultMap="ListResultMap">
        SELECT attachment_id, tenant_id, user_id, session_id, file_name, storage_type, storage_path, status
        FROM attachment
        WHERE user_id = #{userId}
          AND tenant_id = #{tenantId}
          AND status = 'ACTIVE'
        ORDER BY created_at DESC, id DESC
        LIMIT #{limit}
    </select>

    <!-- 详情比列表多 MIME 和大小。仍不带回校验和。 -->
    <resultMap id="DetailResultMap" type="com.zhu.audit.infrastructure.persistence.entity.Attachment">
        <result column="attachment_id" property="attachmentId"/>
        <result column="tenant_id" property="tenantId"/>
        <result column="user_id" property="userId"/>
        <result column="session_id" property="sessionId"/>
        <result column="file_name" property="fileName"/>
        <result column="storage_type" property="storageType"/>
        <result column="storage_path" property="storagePath"/>
        <result column="mime_type" property="mimeType"/>
        <result column="size_bytes" property="sizeBytes"/>
        <result column="status" property="status"/>
    </resultMap>

    <!-- 本人本租户仍启用的一条。不带回校验和。 -->
    <select id="findOwned" resultMap="DetailResultMap">
        SELECT attachment_id, tenant_id, user_id, session_id, file_name, storage_type, storage_path,
               mime_type, size_bytes, status
        FROM attachment
        WHERE attachment_id = #{attachmentId}
          AND user_id = #{userId}
          AND tenant_id = #{tenantId}
          AND status = 'ACTIVE'
        LIMIT 1
    </select>

    <!-- 删文档前取对象键。只看本人、本租户，空路径丢掉。 -->
    <select id="listStoragePathsByRef" resultType="string">
        SELECT a.storage_path
        FROM attachment a
        INNER JOIN attachment_ref r ON r.attachment_id = a.attachment_id
        WHERE a.user_id = #{userId}
          AND a.tenant_id = #{tenantId}
          AND r.ref_type = #{refType}
          AND r.ref_id = #{refId}
          AND a.storage_path IS NOT NULL
          AND a.storage_path &lt;&gt; ''
    </select>
</mapper>
