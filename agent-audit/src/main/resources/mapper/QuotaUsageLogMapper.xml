<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.zhu.audit.infrastructure.persistence.QuotaUsageLogMapper">

    <resultMap id="ListResultMap" type="com.zhu.audit.infrastructure.persistence.entity.QuotaUsageLog">
        <id column="id" property="id"/>
        <result column="tenant_id" property="tenantId"/>
        <result column="user_id" property="userId"/>
        <result column="quota_type" property="quotaType"/>
        <result column="amount" property="amount"/>
        <result column="reason" property="reason"/>
        <result column="created_at" property="createdAt"/>
    </resultMap>

    <!-- 只看一个租户。不把运行标识带出来，这列目前不写。 -->
    <select id="recent" resultMap="ListResultMap">
        SELECT id, tenant_id, user_id, quota_type, amount, reason, created_at
        FROM quota_usage_log
        WHERE tenant_id = #{tenantId}
        ORDER BY created_at DESC, id DESC
        LIMIT #{limit}
    </select>
</mapper>
