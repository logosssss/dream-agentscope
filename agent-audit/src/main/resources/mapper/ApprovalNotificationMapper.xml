<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.zhu.audit.infrastructure.persistence.ApprovalNotificationMapper">

    <resultMap id="ListResultMap" type="com.zhu.audit.infrastructure.persistence.entity.ApprovalNotification">
        <id column="id" property="id"/>
        <result column="approval_id" property="approvalId"/>
        <result column="receiver_id" property="receiverId"/>
        <result column="channel" property="channel"/>
        <result column="send_status" property="sendStatus"/>
    </resultMap>

    <!-- 这个接收人最近的通知。表没有租户列，不按租户再滤。 -->
    <select id="listOwned" resultMap="ListResultMap">
        SELECT id, approval_id, receiver_id, channel, send_status
        FROM approval_notification
        WHERE receiver_id = #{receiverId}
        ORDER BY created_at DESC, id DESC
        LIMIT #{limit}
    </select>
</mapper>
