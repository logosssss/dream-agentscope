<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.zhu.audit.infrastructure.persistence.ApprovalRecordMapper">

    <!-- 查询时的列映射。插入走 BaseMapper.insert，不在这里重复写 INSERT。 -->
    <resultMap id="BaseResultMap" type="com.zhu.audit.infrastructure.persistence.entity.ApprovalRecord">
        <id column="id" property="id"/>
        <result column="approval_id" property="approvalId"/>
        <result column="user_id" property="userId"/>
        <result column="session_id" property="sessionId"/>
        <result column="run_id" property="runId"/>
        <result column="tool_name" property="toolName"/>
        <result column="action" property="action"/>
        <result column="decision" property="decision"/>
        <result column="approver" property="approver"/>
        <result column="channel" property="channel"/>
        <result column="reason" property="reason"/>
        <result column="requested_at" property="requestedAt"/>
        <result column="decided_at" property="decidedAt"/>
        <result column="executed_at" property="executedAt"/>
        <result column="result" property="result"/>
        <result column="created_at" property="createdAt"/>
    </resultMap>

    <!-- 管理端待审批。决定写死 PENDING，条数用占位符。 -->
    <select id="pending" resultMap="BaseResultMap">
        SELECT id, approval_id, user_id, session_id, run_id, tool_name, action, decision,
               approver, channel, reason, requested_at, decided_at, executed_at, result, created_at
        FROM approval_record
        WHERE decision = 'PENDING'
        ORDER BY id DESC
        LIMIT #{limit}
    </select>

    <select id="findByApprovalId" resultMap="BaseResultMap">
        SELECT id, approval_id, user_id, session_id, run_id, tool_name, action, decision,
               approver, channel, reason, requested_at, decided_at, executed_at, result, created_at
        FROM approval_record
        WHERE approval_id = #{approvalId}
    </select>

    <!-- 条件写在 WHERE 里，已决定的单据不会被覆盖。不改执行时间和结果。 -->
    <update id="decidePending">
        UPDATE approval_record
        SET decision = #{decision},
            approver = #{approver},
            channel = #{channel},
            reason = #{reason},
            decided_at = #{decidedAt}
        WHERE approval_id = #{approvalId}
          AND decision = 'PENDING'
    </update>

</mapper>
