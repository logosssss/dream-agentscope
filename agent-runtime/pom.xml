<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.zhu</groupId>
        <artifactId>dream-agentscope</artifactId>
        <version>0.1.0-SNAPSHOT</version>
    </parent>

    <artifactId>agent-runtime</artifactId>
    <name>agent-runtime</name>

    <dependencies>
        <dependency>
            <groupId>com.zhu</groupId>
            <artifactId>agent-common</artifactId>
        </dependency>
        <dependency>
            <groupId>com.zhu</groupId>
            <artifactId>agent-readmodel</artifactId>
        </dependency>
        <dependency>
            <groupId>com.zhu</groupId>
            <artifactId>agent-semantic</artifactId>
        </dependency>
        <dependency>
            <!-- 产品契约。runtime 只认 ProductModule，不认识具体产品实现。 -->
            <groupId>com.zhu</groupId>
            <artifactId>agent-product-api</artifactId>
        </dependency>
        <dependency>
            <groupId>com.zhu</groupId>
            <artifactId>agent-state</artifactId>
        </dependency>
        <dependency>
            <groupId>com.zhu</groupId>
            <artifactId>agent-vector</artifactId>
        </dependency>
        <dependency>
            <groupId>com.zhu</groupId>
            <artifactId>agent-cache-api</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter</artifactId>
        </dependency>
        <dependency>
            <!-- 事件/用量/安全/模型查找 Mapper 已迁入本模块。 -->
            <groupId>com.baomidou</groupId>
            <artifactId>mybatis-plus-spring-boot3-starter</artifactId>
        </dependency>
        <dependency>
            <groupId>io.agentscope</groupId>
            <artifactId>agentscope-harness</artifactId>
        </dependency>
        <dependency>
            <groupId>io.agentscope</groupId>
            <artifactId>agentscope-extensions-model-dashscope</artifactId>
        </dependency>
        <!-- 指标只用 API（MeterRegistry），Prometheus 注册表由两个进程引入。 -->
        <dependency>
            <groupId>io.micrometer</groupId>
            <artifactId>micrometer-core</artifactId>
        </dependency>
        <dependency>
            <groupId>io.opentelemetry</groupId>
            <artifactId>opentelemetry-sdk-extension-autoconfigure</artifactId>
        </dependency>
        <dependency>
            <groupId>io.opentelemetry</groupId>
            <artifactId>opentelemetry-exporter-otlp</artifactId>
        </dependency>
        <!-- 试点：模块内纯单元测（见 docs/bootstrap-test-sink-落地.md） -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- 复用测试替身：StubProductModule 等，只在测试类路径上。 -->
        <dependency>
            <groupId>com.zhu</groupId>
            <artifactId>agent-test-support</artifactId>
            <type>test-jar</type>
            <scope>test</scope>
        </dependency>
    </dependencies>
    <build>
        <plugins>
            <!-- 业务层只认 CacheFacade（agent-cache-api），实现留在 agent-cache-redis，避免把 Redisson 细节带进 runtime。 -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-enforcer-plugin</artifactId>
                <executions>
                    <execution>
                        <id>enforce-cache-api-only</id>
                        <phase>validate</phase>
                        <goals>
                            <goal>enforce</goal>
                        </goals>
                        <configuration>
                            <rules>
                                <bannedDependencies>
                                    <searchTransitive>false</searchTransitive>
                                    <excludes>
                                        <exclude>com.zhu:agent-cache-redis</exclude>
                                    </excludes>
                                    <message>agent-runtime 只能用 agent-cache-api，不得直接依赖 Redis 缓存实现。</message>
                                </bannedDependencies>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
